/*
 * fileopens.bt - Trace file opens system-wide.
 *
 * This eBPF script hooks into the tracepoint for the openat() system call.
 * Whenever any process on the system calls openat(), it prints the process name,
 * the process ID (PID), and the filename being opened.
 */

tracepoint:syscalls:sys_enter_openat
{
    printf("PID %-6d [%-16s] opened: %s\n", pid, comm, str(args->filename));
}
